# Which chain: aevum (testnet 44005), fork (make fork, 440050) or local (make anvil, 31337)
NETWORK=aevum
# RPC_URL=https://rpc-test.qday.info

# The agent's own key. Give it a little tQDAY for gas and NO tUSD8. Never commit the real value.
AGENT_PRIVATE_KEY=0x...

# Public Aevum deployment (deployments/44005.json). Replace with your own if you redeploy.
VAULT_ADDRESS=0xa95347A05A6262583677f5c6Fbbf129eFD018182
REGISTRY_ADDRESS=0x905270563F7B976D592345eF133F5dFF0541670c
LEASH_ID=1
START_BLOCK=3310431

# Optional: lets the agent read PDFs and free-form invoices. Without it, built-in rules read plain-text invoices.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5

PORT=8787
CORS_ORIGIN=*
KEEPER_INTERVAL_MS=15000
STOP_ON_SUSPICIOUS=true
# Largest gasless deposit the relay accepts, in tUSD8 base units (6 decimals): 100 tUSD8
RELAY_MAX_AMOUNT=100000000
